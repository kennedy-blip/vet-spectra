{
  "appId": "com.vetspectra.clinical",
  "appName": "VET-SPECTRA",
  "webDir": "build",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": true,
    "backgroundColor": "#0b0f14"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#0b0f14",
      "showSpinner": false
    }
  }
}
