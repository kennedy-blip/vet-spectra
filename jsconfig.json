{
	"compilerOptions": {
		"moduleResolution": "bundler",
		"target": "ES2022",
		"module": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"checkJs": false,
		"allowJs": true,
		"resolveJsonModule": true,
		"baseUrl": ".",
		"paths": {
			"$lib": ["src/lib"],
			"$lib/*": ["src/lib/*"]
		}
	},
	"include": ["src/**/*.js", "src/**/*.svelte", "vite.config.js", "svelte.config.js"],
	"exclude": ["node_modules", "build", "android"]
}
