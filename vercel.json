{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci --no-audit --no-fund",
  "outputDirectory": "build",
  "cleanUrls": true,
  "trailingSlash": false,
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/_app/immutable/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/releases/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), accelerometer=(self), gyroscope=(self), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/vet_physics",
      "destination": "/api/index"
    },
    {
      "source": "/api/vet_physics/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|_app/|releases/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/releases/vet-spectra-v27.0.0.apk",
      "destination": "https://github.com/kennedy-blip/vet-spectra/releases/latest/download/vet-spectra-v27.0.0.apk",
      "permanent": false
    }
  ]
}
